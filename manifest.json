{
  "schema": 2,
  "required_executas": [
    { "tool_id": "tool-mini-notes-summarizer", "min_version": "0.1.0" }
  ],
  "optional_executas": [],
  "permissions": ["storage.read", "storage.write", "tools.invoke", "llm.complete"],
  "host_capabilities": ["aps.kv", "llm.sample"],
  "system_prompt_addendum": "The user has the Mini Notes app. Notes live in the app's own storage; summaries are produced by the bundled tool-mini-notes-summarizer Executa via host sampling. Open the 'main' view with open_app_view when the user wants to jot down or review notes.",
  "tags": ["notes", "productivity", "sampling"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 480 },
        "default_size": { "w": 520, "h": 720 },
        "max_size": { "w": 1280, "h": 1600 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "storage": ["get", "set"],
      "tools": ["required:tool-mini-notes-summarizer"],
      "llm": ["complete"],
      "window": ["set_title"]
    }
  },
  "dev": {
    "user_id": 1,
    "seed_storage": {}
  }
}
